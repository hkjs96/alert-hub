// Prisma schema for alert-hub.
//
// This is the "event plane": it receives already-fired alarms, dedups them by
// fingerprint, stores a provider-agnostic normalized shape, and keeps an
// append-only event history. The model intentionally leaves room for later
// features (assignee/routing/grouping) without forcing columns now.

generator client {
  provider      = "prisma-client-js"
  // "native" builds the engine for the local dev machine. The extra RHEL target
  // is a future-proofing seed for AWS Lambda / Vercel (Amazon Linux) so the
  // EC2 -> serverless migration doesn't need a schema change. Harmless locally.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime uses the POOLED connection (Supabase Supavisor / PgBouncer,
  // port 6543, ?pgbouncer=true) so a serverless fleet can't exhaust Postgres
  // connections — this pre-solves the pooling problem before any Lambda move.
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate / db push) need a DIRECT connection (port 5432),
  // because they run DDL the pooler can't. Locally, point both at the same DB.
  directUrl = env("DIRECT_URL")
}

model Alert {
  id          String @id @default(cuid())
  fingerprint String @unique

  title       String
  description String?

  source   String @default("cloudwatch")
  severity String @default("UNKNOWN")
  status   String @default("FIRING")

  resource    String?
  metric      String?
  namespace   String?
  value       String?
  threshold   Float?
  comparison  String?
  region      String?
  accountId   String?
  stateReason String?

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  raw Json?

  // 자동 에스컬레이션 (Phase 3): how many people of the frozen order have been
  // notified for the current incident (1 = 1순위 only, right after firing) and
  // when the last escalation went out. Both reset on each transition INTO
  // FIRING; the cron walks step → step+1 while the alert stays un-acked.
  escalationStep Int       @default(1)
  escalatedAt    DateTime?
  // 마지막 FIRING 팬아웃이 나간 시각 — 재발화 스로틀(플랩 억제)의 기준.
  // REFIRE_THROTTLE_MINUTES 안에 다시 FIRING으로 전이해도 재페이징하지 않는다.
  // 누가 ack했는지 (SSO 세션의 이름). 세션이 없으면 null.
  ackedBy        String?
  lastNotifiedAt DateTime?

  // 수신 시점 담당 스냅샷 (BR-05): the chain + ordered assignees in effect when
  // the alert was received (refreshed on each transition INTO FIRING, i.e. the
  // order that was actually notified). Display prefers this over the live
  // resolution so reordering a team later doesn't rewrite who was responsible
  // for past alerts. Names are denormalized so the record survives renames and
  // deletions. JSON on purpose — an append-style audit shape, never joined.
  ownershipSnapshot Json?
  // 테넌트 스코프용 비정규화: 스냅샷 체인의 고객사 id (FK 없음 — 스냅샷과 같은 이유).
  // 온콜은 자기 담당 고객사의 알람만 보므로 이 열로 거른다. 미매핑 알람은 null.
  customerId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        AlertEvent[]
  notifications NotificationLog[]
  silences      Silence[]
  notifyJobs    NotificationJob[]
  slackMessages SlackMessage[]
  resolutions   Resolution[]

  @@index([status])
  @@index([severity])
  @@index([lastSeenAt])
  @@index([customerId])
}

model AlertEvent {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  status      String
  stateReason String?
  value       String?

  createdAt DateTime @default(now())

  @@index([alertId])
}

// 채널별 통지 결과 기록. AlertEvent가 "알람에 무슨 일이 있었나"라면 이건
// "우리가 누구를 어떻게 불렀고 그게 나갔나"다 — 통지 실패는 조용히 삼켜지는
// 대신 여기 남아서 상세 화면에 보인다. append-only.
model NotificationLog {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  channel        String // slack | email | twilio
  // Who was addressed, human-readable ("최민서 외 1명").
  target         String?
  // null = 최초 FIRING 팬아웃, n = n순위 자동 에스컬레이션.
  escalationStep Int?
  ok             Boolean
  error          String?

  createdAt DateTime @default(now())

  @@index([alertId])
}

// 통지 아웃박스 (신뢰성 트랙 ①). 채널별 발송 시도를 잡(job)으로 떨어뜨리고
// 지수 백오프(30s·1m·2m·5m·10m)로 재시도한다 — Slack이 죽어 있던 5분 때문에
// 통지가 증발하면 안 된다. 발화 시 인라인으로 1회 즉시 시도(지연 없음)하고,
// 실패분만 큐에 남아 틱(/api/cron/notify)이 마저 민다. 5회 실패 시 포기하고
// NotificationLog에 남긴다. 선점은 attempts 낙관적 갱신으로 한다.
// 해결 기록 (사실 층). 알람이 RESOLVED 로 갈 때마다 한 행 — 사람이 닫았든
// 공급자 OK 로 저절로 풀렸든. 사람이 타이핑하는 칸은 없고, 나중에 한 번 클릭
// (kind)이나 스레드 요약이 덧붙는다. "이전 처리" 카드와 AI 메모의 재료.
// 스코프 id 는 FK 없이 값으로 남긴다 — 서비스가 지워져도 기록은 남아야 한다.
model Resolution {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  customerId String?
  serviceId  String?
  namespace  String?
  metric     String?
  resource   String?
  title      String

  firedAt        DateTime
  resolvedAt     DateTime
  durationSec    Int
  // "auto"(공급자 OK) | "manual"(사람이 닫음)
  via            String
  ackedBy        String?
  resolvedBy     String?
  escalationStep Int      @default(1)
  muted          Boolean  @default(false)

  // 한 번 클릭 분류: restart | config | auto | other. 자동 회복은 "auto" 로 미리 채운다.
  kind       String?
  kindBy     String?
  note       String?
  // 24시간 안에 같은 알람이 다시 FIRING 되면 그 시각 — "그 조치는 오답" 신호.
  recurredAt DateTime?

  createdAt DateTime @default(now())

  @@index([alertId])
  @@index([serviceId, resolvedAt])
  @@index([customerId, resolvedAt])
}

// 봇으로 보낸 Slack 메시지의 좌표. 웹·웹훅에서 상태가 바뀌면 이 메시지를
// chat.update 로 고치고 스레드에 한 줄 남긴다 — 채널에서 보는 사람이 "누가
// 잡았는지"를 alert-hub 에 들어오지 않고도 안다. 웹훅(외부) 메시지는 좌표를
// 돌려주지 않으므로 기록되지 않는다.
model SlackMessage {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel String
  ts      String
  // 원문 — 상태 줄만 갈아끼우고 본문은 유지하기 위해 저장.
  text    String

  createdAt DateTime @default(now())

  @@index([alertId])
}

model NotificationJob {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  channel  String // slack | email | twilio
  // 발송에 필요한 전부의 스냅샷: { alert: NormalizedAlert, ctx: NotifyContext }.
  // 재시도 시점에 원본 행이 변해 있어도 "그때 알리려던 내용"을 보낸다.
  payload  Json
  // 묶음 통지 (v2 프레임 05): 같은 서비스의 FIRING 팬아웃 Slack 잡에
  // "service:<id>"가 박히고 nextAttemptAt이 묶음 창만큼 미뤄진다. 드레인이
  // 같은 키의 due 잡들을 하나의 다이제스트 메시지로 합쳐 보낸다.
  groupKey String?

  // pending → sent | skipped | failed(포기)
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([alertId])
}

// 점검 창 · 뮤트 (노이즈 관리 트랙 ③). 통지(Slack/이메일/전화)와 자동
// 에스컬레이션만 멈춘다 — 수집과 상태 전이는 계속되고, 알람은 목록에 그대로
// 남아 뮤트 칩만 붙는다. 스코프는 정확히 하나(앱 코드에서 강제): 알람 단위
// (alertId) 또는 조직 단위(customerId/projectId/serviceId, 하위로 상속).
// 해제는 revokedAt 기록 — 행을 지우지 않아 일람이 감사 로그로 남는다.
model Silence {
  id String @id @default(cuid())

  alertId    String?
  alert      Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  startsAt  DateTime  @default(now())
  endsAt    DateTime
  // 사유는 필수 — "왜 조용했는가"가 남지 않는 뮤트는 신뢰를 깎는다.
  reason    String
  createdBy String?
  revokedAt DateTime?
  // 점검 종료 요약(v2 프레임 05)이 발송된 시각. 틱이 이 컬럼을 낙관적으로
  // 선점해 요약을 정확히 한 번 보낸다. 발송 실패 시 null로 되돌려 재시도.
  summaryAt DateTime?

  createdAt DateTime @default(now())

  @@index([endsAt])
  @@index([alertId])
}

// --- Org master data (Phase 2a) ---------------------------------------------
// Customer > Project > Service > AwsAccountMap is a strict containment tree:
// the tenant is decided ONCE at Project.customerId and derived by walking up
// everywhere else. Ownership is deliberately NOT a column on these tables —
// it lives in Assignment so it can attach to any level (see docs/org-model.md).

model Customer {
  id           String  @id @default(cuid())
  name         String  @unique
  // Marks the pseudo-customer used for internal (non-client) systems, so
  // customerId never has to be nullable on Project.
  isInternal   Boolean @default(false)
  // 고객사 담당자 로그인 허용 도메인(쉼표 구분, 예 "homenic.co.kr"). 비면 이 고객사
  // 사람은 로그인할 수 없다. 이 도메인으로 SSO 하면 이 고객사 소속 조회 계정이 된다
  // (자기 고객사 알람만, 처리 불가).
  loginDomains String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  silences       Silence[]
  contacts       Contact[]
  teams          Team[]
  routingRules   RoutingRule[]
  assignments    Assignment[]
  notifyChannels NotifyChannel[]
}

model Project {
  id         String   @id @default(cuid())
  name       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       Service[]
  silences       Silence[]
  assignments    Assignment[]
  notifyChannels NotifyChannel[]

  @@unique([customerId, name])
}

model Service {
  id         String  @id @default(cuid())
  name       String
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 런북: 링크(Confluence·Notion·GitHub 문서)와 본문(markdown). 링크는 Slack 메시지에,
  // 본문은 알람 상세와 이후 AI 메모의 인용 재료로. 라우팅 규칙의 런북이 있으면 그것이 우선.
  runbookUrl String?
  runbook    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       AwsAccountMap[]
  silences       Silence[]
  assignments    Assignment[]
  routingRules   RoutingRule[]
  notifyChannels NotifyChannel[]

  @@unique([projectId, name])
}

model AwsAccountMap {
  id          String  @id @default(cuid())
  // 12-digit AWS account id, matched against the accountId parsed from
  // incoming alarm ARNs. Unique: one account belongs to one service (shared
  // accounts get resource-pattern overrides later — see docs/org-model.md).
  accountId   String  @unique
  alias       String?
  // prd | stg | dev ... — first source of truth for environment enrichment.
  environment String?
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
}

model Contact {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  slackId    String?
  department String?
  // null = internal (our company); set = this person belongs to a customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // 비활성: 퇴사·휴직 등. 배정·팀 소속은 그대로 두되 해석과 선택 목록에서
  // 빠지고, SSO 로그인이 거부된다. 삭제와 달리 지난 알람의 이름을 지우지 않는다.
  active           Boolean   @default(true)
  // SSO(JIT)로 처음 만들어졌거나 로그인한 시각. null = 아직 로그인한 적 없음.
  lastLoginAt      DateTime?
  // 통지 채널 확인: 코드/링크/SSO 보증/관리자 수동. 값이 바뀌면 리셋.
  // *VerifiedVia: "code" | "link" | "sso" | "slack-lookup" | "admin:<이름>"
  slackVerifiedAt  DateTime?
  slackVerifiedVia String?
  emailVerifiedAt  DateTime?
  emailVerifiedVia String?
  phoneVerifiedAt  DateTime?
  phoneVerifiedVia String?
  verifyNote       String?
  verifyChannel    String?
  verifyCodeHash   String?
  verifyExpiresAt  DateTime?

  verifications ChannelVerification[]

  // --- 계정(내부 인원만 의미 있음; 고객사 담당자는 로그인 대상이 아니다) ---
  // 역할: ADMIN(등록 관리 전체·승인), OPERATOR(알람 처리·점검 창), VIEWER(조회).
  role           Role          @default(OPERATOR)
  // 가입 상태: SSO로 처음 들어온 사람은 PENDING, 관리자가 승인하면 ACTIVE.
  // 관리자가 화면에서 미리 등록한 사람은 ACTIVE로 시작한다(초대와 같다).
  status         AccountStatus @default(ACTIVE)
  approvedAt     DateTime?
  approvedBy     String?
  // 첫 로그인 프로필 완성(환영 단계)을 마친 시각. null = 아직.
  onboardedAt    DateTime?
  timezone       String?
  // 승인 요청 알림을 마지막으로 보낸 시각 (시간당 1회로 제한).
  approvalPingAt DateTime?
  // 테넌트 스코프 예외: 배정과 무관하게 모든 고객사를 본다(관제·리드). ADMIN 은 항상 전체.
  seeAll         Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     Assignment[]
  teamMemberships TeamMember[]
  shiftSlots      OnCallShiftMember[]
  overrides       OnCallOverride[]

  @@index([email])
}

// 팀 (에스컬레이션 그룹): 재사용 가능한 순번 목록. "누구"를 "어디"에서
// 떼어낸다 — 인프라팀/DB팀처럼 기능 조직으로 온콜을 도는 고객은 서비스
// 10개에 팀 하나를 붙이고 순서는 한 곳에서만 관리한다. customerId가 null이면
// MSP 내부 공용 팀(모든 고객사 스코프에 붙일 수 있음), 있으면 그 고객사 전용.
model Team {
  id         String    @id @default(cuid())
  name       String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // 시프트 창(요일·시각)과 대체 근무 기간을 해석하는 시간대 (IANA).
  timezone   String    @default("Asia/Seoul")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  assignments  Assignment[]
  routingRules RoutingRule[]
  shifts       OnCallShift[]
  overrides    OnCallOverride[]

  @@index([customerId])
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // 팀 안의 순번. 0 = 1순위.
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([teamId, contactId])
  @@index([contactId])
}

// 시프트 (시간대 온콜): 팀 안에서 "이 요일·이 시간 창에는 이 순서"를 정한다.
// PagerDuty의 스케줄 레이어 + restriction 에 해당. 해석 시각이 창 안에 들면
// 시프트 멤버 순서가 팀 기본 순서 앞에 온다(기본 순서는 뒤에 이어져
// 에스컬레이션이 계속된다). 창이 겹치면 priority 가 큰 쪽이 이긴다.
// endMin <= startMin 이면 자정을 넘는 창(예: 18:00 → 09:00)이고 요일은 시작
// 요일 기준이다. 시간은 팀 timezone 으로 해석한다.
model OnCallShift {
  id       String  @id @default(cuid())
  teamId   String
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name     String
  // 쉼표 구분 요일 목록, 0=일 … 6=토. 예 "1,2,3,4,5".
  weekdays String
  startMin Int
  endMin   Int
  priority Int     @default(0)
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OnCallShiftMember[]

  @@index([teamId])
}

model OnCallShiftMember {
  id        String      @id @default(cuid())
  shiftId   String
  shift     OnCallShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  order     Int         @default(0)

  createdAt DateTime @default(now())

  @@unique([shiftId, contactId])
  @@index([contactId])
}

// 대체 근무 (오버라이드): 휴가·교대 스왑용 1회성 덮어쓰기. 기간 안에서는 이
// 사람이 팀의 1순위가 되고, 시프트/기본 순서가 뒤에 이어진다. PagerDuty 의
// override 와 같이 가장 아래 레이어.
model OnCallOverride {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  note      String?

  createdAt DateTime @default(now())

  @@index([teamId, endAt])
}

// One person (or team) attached to one scope. Exactly one of
// customerId/projectId/serviceId/accountId is set (enforced in app code).
// Attach = INSERT, detach = DELETE.
//
// There is no role label (the v0.2 OWNER/DEPUTY/MEMBER axis was dropped in
// v0.3): a scope holds an ordered list and 1순위 is simply order 0. Registering
// someone (조직 · 담당자 관리) appends to the end; reordering (알람 처리 순서)
// is a separate screen so the two decisions stay independent.
model Assignment {
  id        String   @id @default(cuid())
  // Position within this scope's list. 0 = 1순위 = first notified. Contiguous
  // per scope; the actions renumber on remove/reorder.
  order     Int      @default(0)
  // 항목은 사람(contactId) 또는 팀(teamId) 중 정확히 하나 (앱 코드에서 강제).
  // 팀 항목은 해석 시점에 팀의 멤버 순서로 펼쳐진다 — 여러 스코프가 같은
  // 팀을 참조하면 순서는 팀 한 곳에서만 관리된다 (PagerDuty의 escalation
  // policy와 같은 분리).
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  accountId  String?
  account    AwsAccountMap? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One person holds at most one position per scope. Postgres treats NULLs as
  // distinct, so each pair only bites for rows attached to that level —
  // together with the app-level check this closes the add/add race.
  @@unique([contactId, customerId])
  @@unique([contactId, projectId])
  @@unique([contactId, serviceId])
  @@unique([contactId, accountId])
  @@unique([teamId, customerId])
  @@unique([teamId, projectId])
  @@unique([teamId, serviceId])
  @@unique([teamId, accountId])
  @@index([contactId])
  @@index([teamId])
  @@index([customerId])
  @@index([projectId])
  @@index([serviceId])
  @@index([accountId])
}

// 라우팅 규칙 (Phase 3): 조직 트리 순서를 알람 속성으로 덮어쓴다. "RDS 네임스페이스는
// 무조건 DB팀", "CRITICAL은 야간 당직팀"처럼 프로젝트 축이 아니라 기능 축으로
// 온콜을 도는 고객사를 위한 것. 고객사 단위로 정의되고, 우선순위 오름차순으로
// 첫 매치가 이긴다. 비어 있는 조건은 와일드카드, 패턴은 `*` 글롭(대소문자 무시).
model RoutingRule {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // 사람이 읽는 이름 (스냅샷·상세에 남는다).
  name       String
  priority   Int      @default(100)
  enabled    Boolean  @default(true)

  // 조건 — 모두 선택. 비면 무엇이든 매치.
  namespace String?
  metric    String?
  // 쉼표 구분 목록, 예 "CRITICAL,SEV-1".
  severity  String?
  resource  String?
  // 특정 서비스에만 적용하고 싶을 때. 서비스가 지워지면 규칙은 전체 적용으로 넓어지지
  // 않도록 규칙도 함께 지운다.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // 규칙별 런북 (예: "RDS CPU" 규칙엔 RDS 절만). 서비스 런북보다 구체적이라 우선.
  runbookUrl String?
  runbook    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, priority])
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

// 통지 채널 (스코프별 Slack 목적지). 담당자 배정과 같은 상속 규칙 — 가장
// 구체적인 스코프에 채널이 하나라도 있으면 그 목록이 통째로 쓰이고, 없으면
// 상위로. 어디에도 없으면 전사 기본(SLACK_DEFAULT_CHANNEL / SLACK_WEBHOOK_URL).
// 종류: SLACK_BOT = 우리 워크스페이스 채널(봇 토큰, 채널 ID), SLACK_WEBHOOK =
// 고객사가 자기 워크스페이스에서 발급해 준 Incoming Webhook URL.
enum ChannelKind {
  SLACK_BOT
  SLACK_WEBHOOK
}

model NotifyChannel {
  id      String      @id @default(cuid())
  kind    ChannelKind
  // 사람이 읽는 이름, 예 "홈닉 공유 채널", "내부 온콜".
  label   String
  // SLACK_BOT: 채널 ID(C…) 또는 #이름. SLACK_WEBHOOK: https://hooks.slack.com/…
  target  String
  enabled Boolean     @default(true)

  // 스코프 — 정확히 하나.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // 마지막 테스트/발송 결과.
  lastOkAt  DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([projectId])
  @@index([serviceId])
}

// 관리자가 대신 보내는 확인 요청(링크). 받은 사람이 로그인 없이 링크를 열면
// 그 채널이 확인됨으로 기록된다. 토큰은 해시로만 저장, 24시간 유효, 1회용.
model ChannelVerification {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     String
  tokenHash   String    @unique
  expiresAt   DateTime
  sentAt      DateTime  @default(now())
  usedAt      DateTime?
  requestedBy String?

  @@index([contactId, channel])
}

// 운영 설정 (환경변수 대신 화면에서 바꾸는 값). 키/값 문자열.
// 지금 쓰는 키: "signup.autoApprove" = "on" | "off" (없으면 AUTH_AUTO_APPROVE 환경변수).
model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
