// Prisma schema for alert-hub.
//
// This is the "event plane": it receives already-fired alarms, dedups them by
// fingerprint, stores a provider-agnostic normalized shape, and keeps an
// append-only event history. The model intentionally leaves room for later
// features (assignee/routing/grouping) without forcing columns now.

generator client {
  provider      = "prisma-client-js"
  // "native" builds the engine for the local dev machine. The extra RHEL target
  // is a future-proofing seed for AWS Lambda / Vercel (Amazon Linux) so the
  // EC2 -> serverless migration doesn't need a schema change. Harmless locally.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime uses the POOLED connection (Supabase Supavisor / PgBouncer,
  // port 6543, ?pgbouncer=true) so a serverless fleet can't exhaust Postgres
  // connections — this pre-solves the pooling problem before any Lambda move.
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate / db push) need a DIRECT connection (port 5432),
  // because they run DDL the pooler can't. Locally, point both at the same DB.
  directUrl = env("DIRECT_URL")
}

model Alert {
  id          String @id @default(cuid())
  fingerprint String @unique

  title       String
  description String?

  source   String @default("cloudwatch")
  severity String @default("UNKNOWN")
  status   String @default("FIRING")

  resource    String?
  metric      String?
  namespace   String?
  value       String?
  threshold   Float?
  comparison  String?
  region      String?
  accountId   String?
  stateReason String?

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  raw Json?

  // 자동 에스컬레이션 (Phase 3): how many people of the frozen order have been
  // notified for the current incident (1 = 1순위 only, right after firing) and
  // when the last escalation went out. Both reset on each transition INTO
  // FIRING; the cron walks step → step+1 while the alert stays un-acked.
  escalationStep Int       @default(1)
  escalatedAt    DateTime?
  // 마지막 FIRING 팬아웃이 나간 시각 — 재발화 스로틀(플랩 억제)의 기준.
  // REFIRE_THROTTLE_MINUTES 안에 다시 FIRING으로 전이해도 재페이징하지 않는다.
  // 누가 ack했는지 (SSO 세션의 이름). 세션이 없으면 null.
  ackedBy        String?
  lastNotifiedAt DateTime?

  // 수신 시점 담당 스냅샷 (BR-05): the chain + ordered assignees in effect when
  // the alert was received (refreshed on each transition INTO FIRING, i.e. the
  // order that was actually notified). Display prefers this over the live
  // resolution so reordering a team later doesn't rewrite who was responsible
  // for past alerts. Names are denormalized so the record survives renames and
  // deletions. JSON on purpose — an append-style audit shape, never joined.
  ownershipSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        AlertEvent[]
  notifications NotificationLog[]
  silences      Silence[]
  notifyJobs    NotificationJob[]

  @@index([status])
  @@index([severity])
  @@index([lastSeenAt])
}

model AlertEvent {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  status      String
  stateReason String?
  value       String?

  createdAt DateTime @default(now())

  @@index([alertId])
}

// 채널별 통지 결과 기록. AlertEvent가 "알람에 무슨 일이 있었나"라면 이건
// "우리가 누구를 어떻게 불렀고 그게 나갔나"다 — 통지 실패는 조용히 삼켜지는
// 대신 여기 남아서 상세 화면에 보인다. append-only.
model NotificationLog {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  channel        String // slack | email | twilio
  // Who was addressed, human-readable ("최민서 외 1명").
  target         String?
  // null = 최초 FIRING 팬아웃, n = n순위 자동 에스컬레이션.
  escalationStep Int?
  ok             Boolean
  error          String?

  createdAt DateTime @default(now())

  @@index([alertId])
}

// 통지 아웃박스 (신뢰성 트랙 ①). 채널별 발송 시도를 잡(job)으로 떨어뜨리고
// 지수 백오프(30s·1m·2m·5m·10m)로 재시도한다 — Slack이 죽어 있던 5분 때문에
// 통지가 증발하면 안 된다. 발화 시 인라인으로 1회 즉시 시도(지연 없음)하고,
// 실패분만 큐에 남아 틱(/api/cron/notify)이 마저 민다. 5회 실패 시 포기하고
// NotificationLog에 남긴다. 선점은 attempts 낙관적 갱신으로 한다.
model NotificationJob {
  id      String @id @default(cuid())
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  channel  String // slack | email | twilio
  // 발송에 필요한 전부의 스냅샷: { alert: NormalizedAlert, ctx: NotifyContext }.
  // 재시도 시점에 원본 행이 변해 있어도 "그때 알리려던 내용"을 보낸다.
  payload  Json
  // 묶음 통지 (v2 프레임 05): 같은 서비스의 FIRING 팬아웃 Slack 잡에
  // "service:<id>"가 박히고 nextAttemptAt이 묶음 창만큼 미뤄진다. 드레인이
  // 같은 키의 due 잡들을 하나의 다이제스트 메시지로 합쳐 보낸다.
  groupKey String?

  // pending → sent | skipped | failed(포기)
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([alertId])
}

// 점검 창 · 뮤트 (노이즈 관리 트랙 ③). 통지(Slack/이메일/전화)와 자동
// 에스컬레이션만 멈춘다 — 수집과 상태 전이는 계속되고, 알람은 목록에 그대로
// 남아 뮤트 칩만 붙는다. 스코프는 정확히 하나(앱 코드에서 강제): 알람 단위
// (alertId) 또는 조직 단위(customerId/projectId/serviceId, 하위로 상속).
// 해제는 revokedAt 기록 — 행을 지우지 않아 일람이 감사 로그로 남는다.
model Silence {
  id String @id @default(cuid())

  alertId    String?
  alert      Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  startsAt  DateTime  @default(now())
  endsAt    DateTime
  // 사유는 필수 — "왜 조용했는가"가 남지 않는 뮤트는 신뢰를 깎는다.
  reason    String
  createdBy String?
  revokedAt DateTime?
  // 점검 종료 요약(v2 프레임 05)이 발송된 시각. 틱이 이 컬럼을 낙관적으로
  // 선점해 요약을 정확히 한 번 보낸다. 발송 실패 시 null로 되돌려 재시도.
  summaryAt DateTime?

  createdAt DateTime @default(now())

  @@index([endsAt])
  @@index([alertId])
}

// --- Org master data (Phase 2a) ---------------------------------------------
// Customer > Project > Service > AwsAccountMap is a strict containment tree:
// the tenant is decided ONCE at Project.customerId and derived by walking up
// everywhere else. Ownership is deliberately NOT a column on these tables —
// it lives in Assignment so it can attach to any level (see docs/org-model.md).

model Customer {
  id         String  @id @default(cuid())
  name       String  @unique
  // Marks the pseudo-customer used for internal (non-client) systems, so
  // customerId never has to be nullable on Project.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]
  silences    Silence[]
  contacts    Contact[]
  teams       Team[]
  assignments Assignment[]
}

model Project {
  id         String   @id @default(cuid())
  name       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services    Service[]
  silences    Silence[]
  assignments Assignment[]

  @@unique([customerId, name])
}

model Service {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    AwsAccountMap[]
  silences    Silence[]
  assignments Assignment[]

  @@unique([projectId, name])
}

model AwsAccountMap {
  id          String  @id @default(cuid())
  // 12-digit AWS account id, matched against the accountId parsed from
  // incoming alarm ARNs. Unique: one account belongs to one service (shared
  // accounts get resource-pattern overrides later — see docs/org-model.md).
  accountId   String  @unique
  alias       String?
  // prd | stg | dev ... — first source of truth for environment enrichment.
  environment String?
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
}

model Contact {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  slackId    String?
  department String?
  // null = internal (our company); set = this person belongs to a customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // 비활성: 퇴사·휴직 등. 배정·팀 소속은 그대로 두되 해석과 선택 목록에서
  // 빠지고, SSO 로그인이 거부된다. 삭제와 달리 지난 알람의 이름을 지우지 않는다.
  active      Boolean   @default(true)
  // SSO(JIT)로 처음 만들어졌거나 로그인한 시각. null = 아직 로그인한 적 없음.
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     Assignment[]
  teamMemberships TeamMember[]

  @@index([email])
}

// 팀 (에스컬레이션 그룹): 재사용 가능한 순번 목록. "누구"를 "어디"에서
// 떼어낸다 — 인프라팀/DB팀처럼 기능 조직으로 온콜을 도는 고객은 서비스
// 10개에 팀 하나를 붙이고 순서는 한 곳에서만 관리한다. customerId가 null이면
// MSP 내부 공용 팀(모든 고객사 스코프에 붙일 수 있음), 있으면 그 고객사 전용.
model Team {
  id         String    @id @default(cuid())
  name       String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  assignments Assignment[]

  @@index([customerId])
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // 팀 안의 순번. 0 = 1순위.
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([teamId, contactId])
  @@index([contactId])
}

// One person (or team) attached to one scope. Exactly one of
// customerId/projectId/serviceId/accountId is set (enforced in app code).
// Attach = INSERT, detach = DELETE.
//
// There is no role label (the v0.2 OWNER/DEPUTY/MEMBER axis was dropped in
// v0.3): a scope holds an ordered list and 1순위 is simply order 0. Registering
// someone (조직 · 담당자 관리) appends to the end; reordering (알람 처리 순서)
// is a separate screen so the two decisions stay independent.
model Assignment {
  id        String   @id @default(cuid())
  // Position within this scope's list. 0 = 1순위 = first notified. Contiguous
  // per scope; the actions renumber on remove/reorder.
  order     Int      @default(0)
  // 항목은 사람(contactId) 또는 팀(teamId) 중 정확히 하나 (앱 코드에서 강제).
  // 팀 항목은 해석 시점에 팀의 멤버 순서로 펼쳐진다 — 여러 스코프가 같은
  // 팀을 참조하면 순서는 팀 한 곳에서만 관리된다 (PagerDuty의 escalation
  // policy와 같은 분리).
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  accountId  String?
  account    AwsAccountMap? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One person holds at most one position per scope. Postgres treats NULLs as
  // distinct, so each pair only bites for rows attached to that level —
  // together with the app-level check this closes the add/add race.
  @@unique([contactId, customerId])
  @@unique([contactId, projectId])
  @@unique([contactId, serviceId])
  @@unique([contactId, accountId])
  @@unique([teamId, customerId])
  @@unique([teamId, projectId])
  @@unique([teamId, serviceId])
  @@unique([teamId, accountId])
  @@index([contactId])
  @@index([teamId])
  @@index([customerId])
  @@index([projectId])
  @@index([serviceId])
  @@index([accountId])
}
