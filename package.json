{
  "name": "alert-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node prisma/seed.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "env:push": "node scripts/vercel-env.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "prisma db push --skip-generate --accept-data-loss && node prisma/seed.mjs && next build"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.35",
    "nodemailer": "9.0.5",
    "pretendard": "^1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/nodemailer": "8.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  }
}
