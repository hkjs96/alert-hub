# Vercel production 환경변수 — 값을 채운 뒤 `npm run env:push`
# (이 파일을 .env.vercel 로 복사해서 쓰세요. .env.vercel 은 git 에 올라가지 않습니다.)

# --- Google SSO ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 16자 이상 무작위. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_ALLOWED_DOMAINS=mz.co.kr,megazone.com
AUTH_ALLOWED_EMAILS=jsmini3814@gmail.com
# 첫 로그인에 바로 관리자가 되는 계정 (본인)
AUTH_BOOTSTRAP_ADMINS=jsmini3814@gmail.com
# 회사 도메인 전원을 믿으면 true (승인 없이 즉시 활성)
AUTH_AUTO_APPROVE=true
APP_URL=https://alert-hub-rho.vercel.app

# --- 운영 ---
SEED_DEMO=false
INGEST_TOKEN=
CRON_SECRET=
SLACK_WEBHOOK_URL=
# Slack 앱 봇 토큰 (chat:write, chat:write.public, im:write, users:read.email)
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#alert-hub-oncall
