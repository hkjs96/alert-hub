# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alert_hub?schema=public"

# Slack Incoming Webhook URL. If unset, Slack notifications are skipped.
SLACK_WEBHOOK_URL=""

# Optional shared secret. If set, incoming webhooks must send header
# `x-webhook-token: <INGEST_TOKEN>` or they are rejected with 401.
INGEST_TOKEN=""
