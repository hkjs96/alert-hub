# --- Database ---------------------------------------------------------------
# Prisma uses two URLs:
#   DATABASE_URL = POOLED connection  (app runtime)
#   DIRECT_URL   = DIRECT connection  (prisma migrate / db push)
#
# Local dev (plain local Postgres): point BOTH at the same instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alert_hub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alert_hub?schema=public"
#
# Supabase (free tier) — from Project Settings > Database > Connection string:
#   DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true
#   DIRECT_URL   = "Direct connection"  (port 5432)
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Notifications -----------------------------------------------------------
# Slack Incoming Webhook URL. If unset, Slack notifications are skipped.
SLACK_WEBHOOK_URL=""

# Public base URL of this app (no trailing slash). When set, notifications
# include a deep link to the alert detail page.
APP_URL=""

# --- Ingest auth -------------------------------------------------------------
# Optional shared secret. If set, incoming webhooks must send header
# `x-webhook-token: <INGEST_TOKEN>` or they are rejected with 401.
INGEST_TOKEN=""

# --- Email channel (Phase 3) -------------------------------------------------
# SMTP for the email notifier — vendor-neutral (SES, Gmail, 사내 릴레이…).
# SMTP_HOST 또는 SMTP_FROM이 비어 있으면 이메일 통지는 건너뛴다.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" = implicit TLS (보통 포트 465)
SMTP_USER=""          # 비우면 무인증 릴레이
SMTP_PASS=""
SMTP_FROM="alert-hub <alerts@example.com>"

# --- 자동 에스컬레이션 (Phase 3) ---------------------------------------------
# GET /api/cron/escalate 공유 비밀. 미설정이면 엔드포인트가 503 = 기능 꺼짐.
# 외부 스케줄러(crontab, Vercel Cron 등)가 1~수 분 간격으로 호출해야 동작한다:
#   * * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/escalate
CRON_SECRET=""
# 1순위가 이 시간(분) 안에 ack하지 않으면 다음 순위에게 통지. 기본 10.
ESCALATION_ACK_MINUTES="10"

# --- Twilio 전화/SMS (Phase 3, 에스컬레이션 전용) ----------------------------
# 셋 다 있어야 켜진다. 최초 FIRING 통지에는 침묵하고, 자동 에스컬레이션이
# 일어날 때만 다음 순위 한 명의 phone으로 SMS를 보낸다.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""          # Twilio 발신 번호 (+82…)
TWILIO_VOICE="false"    # "true"면 SMS에 이어 전화(TTS)도 건다
TWILIO_VOICE_FROM=""    # 전화 발신 번호 (비우면 TWILIO_FROM)

# --- 웹훅 서명 검증 ----------------------------------------------------------
# SNS 봉투 서명 검증 (기본 켜짐). AWS 인증서로 서명을 확인한 뒤에만 처리한다.
# 로컬에서 서명 없는 SNS 봉투를 테스트할 때만 "false"로.
SNS_VERIFY="true"
# PagerDuty 웹훅 비밀 (PagerDuty 웹훅 설정에서 발급). 설정하면
# X-PagerDuty-Signature(v1 HMAC)가 맞는 요청만 받는다.
PAGERDUTY_WEBHOOK_SECRET=""

# --- Google SSO (선택) -------------------------------------------------------
# 셋 다 있으면 화면·서버 액션이 로그인 뒤로 들어간다. 하나라도 비면 SSO 꺼짐
# (지금처럼 열린 상태, 헤더에 "SSO 미설정" 표시). 웹훅·크론은 영향 없음.
# Google Cloud Console OAuth client (Web) — redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 세션 쿠키 서명 비밀, 16자 이상 (openssl rand -base64 32)
AUTH_SECRET=""
# 허용 이메일 도메인(쉼표 구분), 예 "mz.co.kr,megazone.com".
AUTH_ALLOWED_DOMAINS=""
# 도메인과 무관하게 허용할 개별 이메일(쉼표 구분). 개인 Gmail·외부 협력자용.
# 둘 다 비우면 전부 허용 — 운영에서는 반드시 하나는 채울 것.
AUTH_ALLOWED_EMAILS=""
# 첫 로그인에 바로 관리자·활성이 되는 이메일(쉼표 구분). 첫 관리자를 만드는 길.
AUTH_BOOTSTRAP_ADMINS=""
